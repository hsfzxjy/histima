source = asset("examples/tiny.ppm")

transform darken_byte(value: u8, offset: i64, factor: f32) -> u8 {
    pixel = offset / 4
    alpha = pixel * 4 + 3
    if offset == alpha {
        return value
    } else {
        return u8.scale(value, factor)
    }
}

transform darken(buffer: Buffer, factor: f32) -> Buffer {
    for byte, offset in buffer.bytes {
        byte = darken_byte(byte, offset, factor)
    }
    return buffer
}

decoded = source | read | ppm.decode
darkened = decoded | darken(0.5)
out = darkened | ppm.encode
saved = out | save("build/image_pipeline.ppm")
replayed = replay(saved)

trace(out)
