// Outer values are immutable and may be shared.
source = asset("cat.png")
source_lineage = trace(source)
input = {asset: source, tags: ["example", "first-pass"]}

// The same frontend enters a statically checked context after `transform`.
transform scale(value: f32, factor: f32) -> f32 {
    return value * factor
}

result = 8.0 | scale(factor=0.25)
replayed = replay(result)

trace(result)
